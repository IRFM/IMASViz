#BLUE --> 1
#RED --> 2
#BLACK --> 3
#CYAN --> 4
#LIGHT_CYAN --> 5
#LIGHT_GREY --> 6

Colour_of_data_nodes_containing_data=1
Nodes_selection_colour=2
Allow_data_to_be_plotted_with_different_units=0

# Start window's list of local cases.
#   Affichage : the shape of a row. uri (the default) shows the URI the case
#               is opened with; parsed the backend, database, shot and run
#               behind it.
#   Trier par : which field the list is laid out by.
#               One of : uri | database | backend | shot | run
#   Sens du tri : asc for montant (12 avant 999), desc for descendant
#   Protocoles affichés : both on by default. At least one must stay on;
#               the selector refuses to uncheck the last one.
Uri_list_view=uri
Uri_list_sort_key=database
Uri_list_sort_direction=asc
Uri_list_filter_HDF5=1
Uri_list_filter_MDSplus=1